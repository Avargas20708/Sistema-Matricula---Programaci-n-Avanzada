@model Curso
@{ViewData["Title"]=(Model.Id==0?"Agregar":"Editar")+" curso";}
<h1>@ViewData["Title"]</h1><p class="subtitle">Complete los campos obligatorios y guarde los cambios.</p><section class="panel form-panel"><form method="post"><div asp-validation-summary="All"></div><div class="grid"><div class="field"><label asp-for="Codigo">Código</label><input asp-for="Codigo"/><span asp-validation-for="Codigo"></span></div><div class="field"><label asp-for="Nombre">Nombre</label><input asp-for="Nombre"/><span asp-validation-for="Nombre"></span></div><div class="field"><label asp-for="Creditos">Créditos</label><input asp-for="Creditos"/><span asp-validation-for="Creditos"></span></div><div class="field"><label asp-for="CarreraId">Carrera</label><select asp-for="CarreraId" asp-items="ViewBag.Carreras"><option value="">Seleccione una carrera</option></select><span asp-validation-for="CarreraId"></span></div></div><div class="form-actions"><button>Guardar</button><a asp-action="Index">Cancelar</a></div></form></section>
