@model Docente
@{ViewData["Title"]=(Model.Id==0?"Agregar":"Editar")+" docente";}
<h1>@ViewData["Title"]</h1><p class="subtitle">Complete los campos obligatorios y guarde los cambios.</p><section class="panel form-panel"><form method="post"><div asp-validation-summary="All"></div><div class="grid"><div class="field"><label asp-for="Identificacion">Identificación</label><input asp-for="Identificacion"/><span asp-validation-for="Identificacion"></span></div><div class="field"><label asp-for="Nombre">Nombre</label><input asp-for="Nombre"/><span asp-validation-for="Nombre"></span></div><div class="field"><label asp-for="Correo">Correo electrónico</label><input asp-for="Correo"/><span asp-validation-for="Correo"></span></div><div class="field"><label asp-for="Telefono">Teléfono</label><input asp-for="Telefono"/><span asp-validation-for="Telefono"></span></div></div><div class="form-actions"><button>Guardar</button><a asp-action="Index">Cancelar</a></div></form></section>
