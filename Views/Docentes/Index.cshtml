@model IEnumerable<Docente>
@{ViewData["Title"]="Docentes";}
<h1>Docentes</h1><p class="subtitle">Administración del catálogo académico. Los registros inactivos conservan sus relaciones.</p><div class="toolbar"><form method="get" class="search"><input name="q" value="@ViewBag.Q" placeholder="Buscar por nombre" aria-label="Buscar por nombre"/><button>Buscar</button></form><a class="button" asp-action="Create">Agregar docente</a></div><section class="panel table-scroll"><table><thead><tr><th>Identificación</th><th>Nombre</th><th>Correo electrónico</th><th>Teléfono</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>@foreach(var e in Model){<tr><td>@e.Identificacion</td><td>@e.Nombre</td><td>@e.Correo</td><td>@e.Telefono</td><td><span class="badge @(e.Activo?"":"off")">@(e.Activo?"Activo":"Inactivo")</span></td><td><div class="actions"><a asp-action="Details" asp-route-id="@e.Id">Ver</a><a asp-action="Edit" asp-route-id="@e.Id">Editar</a><a asp-action="Estado" asp-route-id="@e.Id">@(e.Activo?"Desactivar":"Reactivar")</a></div></td></tr>}</tbody></table>@if(!Model.Any()){<p class="empty">No hay registros para mostrar.</p>}</section>
