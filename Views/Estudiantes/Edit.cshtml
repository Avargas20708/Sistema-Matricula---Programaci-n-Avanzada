@model EstudianteEditarVm
@{ViewData["Title"]="Editar estudiante";}<h1>Editar estudiante</h1><p class="subtitle">Actualice el expediente mediante revisión administrativa.</p><section class="panel form-panel"><form method="post"><div asp-validation-summary="All"></div><div class="grid"><div class="field"><label asp-for="Identificacion">Identificación</label><input asp-for="Identificacion"/><span asp-validation-for="Identificacion"></span></div><div class="field"><label asp-for="Nombre">Nombre completo</label><input asp-for="Nombre"/><span asp-validation-for="Nombre"></span></div><div class="field"><label asp-for="Correo">Correo electrónico</label><input asp-for="Correo"/><span asp-validation-for="Correo"></span></div><div class="field"><label asp-for="Telefono">Teléfono</label><input asp-for="Telefono"/><span asp-validation-for="Telefono"></span></div><div class="field"><label asp-for="Direccion">Dirección</label><input asp-for="Direccion"/><span asp-validation-for="Direccion"></span></div><div class="field"><label asp-for="CarreraId">Carrera</label><select asp-for="CarreraId" asp-items="ViewBag.Carreras"><option value="">Seleccione una carrera</option></select><span asp-validation-for="CarreraId"></span></div></div><div class="notice"><label class="check"><input asp-for="RevisionCambioCarrera"/>He revisado el cambio de carrera. Las matrículas anteriores conservarán la carrera histórica.</label><span asp-validation-for="RevisionCambioCarrera"></span></div><div class="form-actions"><button>Guardar cambios</button><a asp-action="Index">Cancelar</a></div></form></section>
