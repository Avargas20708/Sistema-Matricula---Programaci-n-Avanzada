@model IEnumerable<Estudiante>
@{ViewData["Title"]="Estudiantes";}
<h1>Estudiantes</h1><p class="subtitle">Consulte expedientes y controle el acceso de las cuentas.</p><div class="toolbar"><form method="get" class="search"><input name="q" value="@ViewBag.Q" placeholder="Buscar nombre o identificación" aria-label="Buscar estudiante"/><button>Buscar</button></form><a class="button" asp-action="Create">Agregar estudiante</a></div><section class="panel table-scroll"><table><thead><tr><th>Identificación</th><th>Estudiante</th><th>Carrera</th><th>Expediente / acceso</th><th>Acciones</th></tr></thead><tbody>@foreach(var e in Model){<tr><td>@e.Identificacion</td><td>@e.Nombre<small>@e.User!.Email</small></td><td>@e.Carrera!.Nombre</td><td><span class="badge @(e.Activo?"":"off")">@(e.Activo?"Activo":"Inactivo")</span> <span class="badge @(e.User.Habilitado?"":"off")">@(e.User.Habilitado?"Habilitado":"Bloqueado")</span></td><td><div class="actions"><a asp-action="Details" asp-route-id="@e.Id">Ver</a><a asp-action="Edit" asp-route-id="@e.Id">Editar</a><a asp-action="Estado" asp-route-id="@e.Id">@(e.Activo?"Desactivar":"Reactivar")</a><a asp-action="Acceso" asp-route-id="@e.Id">@(e.User.Habilitado?"Bloquear acceso":"Habilitar acceso")</a></div></td></tr>}</tbody></table>@if(!Model.Any()){<p class="empty">No hay estudiantes para mostrar.</p>}</section>
