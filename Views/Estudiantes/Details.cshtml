@model Estudiante
@{ViewData["Title"]="Expediente del estudiante";}<h1>Expediente del estudiante</h1><section class="panel"><dl><dt>Identificación</dt><dd>@Model.Identificacion</dd><dt>Nombre</dt><dd>@Model.Nombre</dd><dt>Correo</dt><dd>@Model.User!.Email</dd><dt>Carrera</dt><dd>@Model.Carrera!.Nombre</dd><dt>Teléfono</dt><dd>@Model.Telefono</dd><dt>Dirección</dt><dd>@Model.Direccion</dd><dt>Expediente</dt><dd>@(Model.Activo?"Activo":"Inactivo")</dd><dt>Acceso</dt><dd>@(Model.User.Habilitado?"Habilitado":"Bloqueado")</dd></dl><div class="form-actions"><a class="button" asp-action="Edit" asp-route-id="@Model.Id">Editar</a><a asp-action="Index">Volver</a></div></section>
