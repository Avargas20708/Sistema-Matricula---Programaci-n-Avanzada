@model IEnumerable<Carrera>
@{ViewData["Title"]="Carreras disponibles";}
<h1>Carreras disponibles</h1><p class="subtitle">Explore la oferta de formación y elija su carrera al registrarse.</p>@if(User.IsInRole("Estudiante")){<div class="notice">Su carrera actual forma parte del expediente. Para solicitar un cambio, comuníquese con administración. Sus matrículas históricas se conservarán.</div>}<div class="cards">@foreach(var c in Model){<article class="card"><span class="badge">@c.Codigo</span><h2 style="margin-top:16px">@c.Nombre</h2><p class="description">@c.Descripcion</p>@if(User.Identity?.IsAuthenticated!=true){<a class="button" asp-controller="Account" asp-action="Register" asp-route-carreraId="@c.Id">Elegir esta carrera</a>}</article>}</div>@if(!Model.Any()){<div class="panel empty">No hay carreras activas publicadas por el momento.</div>}
