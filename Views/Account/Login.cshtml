@model LoginVm
@{ViewData["Title"]="Ingresar";}
<section class="panel auth"><h1>Bienvenido a CAMPUS</h1><p class="subtitle">Ingrese con su cuenta universitaria.</p><form method="post"><div asp-validation-summary="All"></div><input asp-for="ReturnUrl" type="hidden"/><div class="field"><label asp-for="Correo">Correo electrónico</label><input asp-for="Correo" autocomplete="username"/><span asp-validation-for="Correo"></span></div><div class="field"><label asp-for="Password">Contraseña</label><input asp-for="Password" autocomplete="current-password"/><span asp-validation-for="Password"></span></div><button type="submit">Iniciar sesión</button></form><p class="muted" style="margin-top:24px">¿Aún no tiene cuenta? <a asp-action="Register">Registrarse como estudiante</a></p><a asp-controller="Catalogo" asp-action="Index">Consultar carreras disponibles</a></section>
