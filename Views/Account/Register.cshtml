@model RegistroVm
@{ViewData["Title"]="Crear cuenta";}
<h1>Crear cuenta de estudiante</h1><p class="subtitle">Complete su expediente y seleccione una carrera activa.</p><section class="panel form-panel"><form method="post"><div asp-validation-summary="All"></div><div class="grid"><partial name="_RegistroCampos" model="Model"/></div><p class="muted">Contraseña: mínimo 8 caracteres, mayúscula, minúscula, número y símbolo. El rol asignado es Estudiante.</p><div class="form-actions"><button type="submit">Registrarme</button><a asp-action="Login">Ya tengo cuenta</a></div></form></section>
