@model IEnumerable<Carrera>
@{ViewData["Title"]="Carreras";}
<h1>Carreras</h1><p class="subtitle">Administración del catálogo académico. Los registros inactivos conservan sus relaciones.</p><div class="toolbar"><form method="get" class="search"><input name="q" value="@ViewBag.Q" placeholder="Buscar por nombre" aria-label="Buscar por nombre"/><button>Buscar</button></form><a class="button" asp-action="Create">Agregar carrera</a></div><section class="panel table-scroll"><table><thead><tr><th>Código</th><th>Nombre</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>@foreach(var e in Model){<tr><td>@e.Codigo</td><td>@e.Nombre</td><td><span class="badge @(e.Activa?"":"off")">@(e.Activa?"Activo":"Inactivo")</span></td><td><div class="actions"><a asp-action="Details" asp-route-id="@e.Id">Ver</a><a asp-action="Edit" asp-route-id="@e.Id">Editar</a><a asp-action="Estado" asp-route-id="@e.Id">@(e.Activa?"Desactivar":"Reactivar")</a></div></td></tr>}</tbody></table>@if(!Model.Any()){<p class="empty">No hay registros para mostrar.</p>}</section>
