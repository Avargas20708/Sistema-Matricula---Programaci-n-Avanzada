@model PerfilVm
@{ViewData["Title"]="Mi perfil";}
<h1>Mi perfil</h1><p class="subtitle">Consulte su expediente y actualice sus datos de contacto.</p><section class="panel form-panel"><dl><dt>Nombre</dt><dd>@Model.Nombre</dd><dt>Identificación</dt><dd>@Model.Identificacion</dd><dt>Correo</dt><dd>@Model.Correo</dd><dt>Carrera</dt><dd>@Model.Carrera</dd></dl><p class="notice">Los cambios de identificación o carrera requieren revisión administrativa.</p><form method="post"><div asp-validation-summary="All"></div><div class="field"><label asp-for="Telefono">Teléfono</label><input asp-for="Telefono"/><span asp-validation-for="Telefono"></span></div><div class="field"><label asp-for="Direccion">Dirección</label><textarea asp-for="Direccion"></textarea><span asp-validation-for="Direccion"></span></div><button type="submit">Guardar contacto</button></form></section>
