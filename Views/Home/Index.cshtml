@{ViewData["Title"]="Panel principal";}
<h1>@(User.IsInRole("Administrador")?"Panel de administración":"Mi portal académico")</h1><p class="subtitle">@(User.IsInRole("Administrador")?"Gestione los expedientes y la información académica de la universidad.":"Consulte su carrera y mantenga actualizados sus datos de contacto.")</p><div class="cards"><article class="card"><h2>Carreras activas</h2><strong class="number">@ViewBag.Carreras</strong><a asp-controller="Catalogo" asp-action="Index">Consultar catálogo</a></article>@if(User.IsInRole("Administrador")){<article class="card"><h2>Estudiantes activos</h2><strong class="number">@ViewBag.Estudiantes</strong><a asp-controller="Estudiantes" asp-action="Index">Gestionar estudiantes</a></article><article class="card"><h2>Cursos activos</h2><strong class="number">@ViewBag.Cursos</strong><a asp-controller="Cursos" asp-action="Index">Gestionar cursos</a></article>}else{<article class="card"><h2>Mi expediente</h2><p>Revise su carrera y datos de contacto.</p><a class="button" asp-controller="Perfil" asp-action="Index">Consultar mi perfil</a></article>}</div><section class="panel"><h2>Alcance de este avance</h2><p>Registro, autenticación, perfiles, catálogo de carreras y administración académica inicial.</p><p class="muted">La selección de grupos, confirmación de matrícula, comprobantes y retiros se desarrollarán en los siguientes avances.</p></section>
